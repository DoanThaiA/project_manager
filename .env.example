# Copy thành .env (không commit). Sinh giá trị ngẫu nhiên:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Mật khẩu user pm_user trên PostgreSQL dùng chung (scripts/init_db.sh tạo user với mật khẩu này)
PM_DB_PASSWORD=
# Khoá ký JWT — mỗi môi trường một giá trị riêng, dài >= 48 ký tự
SECRET_KEY=

# --- Kết nối tới PostgreSQL của ai_carbon_analyst ---
# Tên container / service PostgreSQL và mạng docker chứa nó (xem: docker ps, docker network ls)
PM_DB_HOST=carbon_analyst_db
PM_DB_NETWORK=ai_carbon_analyst_default
# Dùng cho scripts/init_db.sh (docker exec vào container này với superuser, không cần mật khẩu)
PG_CONTAINER=carbon_analyst_db
PG_SUPERUSER=postgres
# VPS không có carbon: PostgreSQL riêng (docs/DEPLOY.md "Chuyển sang VPS khác") — bỏ # dòng dưới, đặt
# PG_CONTAINER=project_manager_db, PG_SUPERUSER=pm_user; PM_DB_HOST / PM_DB_NETWORK không còn dùng
# COMPOSE_FILE=docker-compose.yml:docker-compose.db.yml

# --- Cổng ---
# Server có nginx đứng trước: 127.0.0.1 (chỉ nginx truy cập). Máy dev / LAN: 0.0.0.0
PM_BIND_ADDR=0.0.0.0
PM_WEB_PORT=3000
PM_API_PORT=8000
# MCP server (ban lãnh đạo, connector URL): cổng nội bộ và domain HTTPS công khai (xem docs/MCP.md)
PM_MCP_PORT=8100
MCP_PUBLIC_BASE_URL=https://dev.mcv.network

# --- Cloudflare Images: lưu ảnh đính kèm công việc (ảnh lỗi / ảnh sau khi sửa) ---
# Dashboard Cloudflare › Images › Overview: Account ID, Account hash
CF_ACCOUNT_ID=
CF_IMAGES_ACCOUNT_HASH=
# My Profile › API Tokens › Create token, quyền Account › Cloudflare Images › Edit
CF_IMAGES_TOKEN=
# Images › Keys: điền key để ảnh riêng tư (link hết hạn sau 1 giờ); bỏ trống = ảnh public
CF_IMAGES_SIGNING_KEY=

# --- Cloudflare R2: lưu file đính kèm (tài liệu, PDF, Excel, zip...) — docs/DEPLOY.md mục 11 ---
# Dashboard › R2: Account ID; bucket tạo sẵn, để private
R2_ACCOUNT_ID=
R2_BUCKET=project-manager
# R2 › Manage R2 API Tokens › Create API token, quyền Object Read & Write, chỉ bucket trên
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Xem trước Word / Excel / PowerPoint qua Microsoft Office Online (Microsoft tải file qua link ký tạm); false = chỉ tải về
FILE_OFFICE_PREVIEW=true

# --- OCR.space: đọc ảnh danh thiếp khi thêm người liên hệ (https://ocr.space/ocrapi) ---
OCR_SPACE_API_KEY=

# --- Thông báo Telegram (đổi trạng thái công việc...) — xem docs/DEPLOY.md mục 10 ---
# Token bot lấy từ @BotFather; bỏ trống = tắt tính năng
TELEGRAM_BOT_TOKEN=
# Địa chỉ web người dùng truy cập, để chèn link "Mở công việc" vào tin nhắn
APP_PUBLIC_URL=https://dev.mcv.network

# --- AI Gateway: dự án gọi Anthropic / OpenAI qua /llm bằng key riêng (docs/LLM_GATEWAY.md) ---
# Khoá mã hoá key nhà cung cấp. Tạo: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bỏ trống = tắt gateway. KHÔNG đổi sau khi đã lưu key (đổi là phải nhập lại toàn bộ key nhà cung cấp)
LLM_ENCRYPTION_KEY=

# PostgreSQL dùng chung với ai_carbon_analyst; mật khẩu = PM_DB_PASSWORD trong ../.env
DATABASE_URL=postgresql+asyncpg://pm_user:<PM_DB_PASSWORD>@localhost:5433/project_manager
# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Cloudflare Images: lưu ảnh đính kèm công việc (ảnh lỗi / ảnh sau khi sửa) ---
# Dashboard Cloudflare › Images › Overview: Account ID, Account hash
CF_ACCOUNT_ID=
CF_IMAGES_ACCOUNT_HASH=
# My Profile › API Tokens › Create token, quyền Account › Cloudflare Images › Edit
CF_IMAGES_TOKEN=
# Images › Keys: điền key để ảnh riêng tư (link hết hạn sau 1 giờ); bỏ trống = ảnh public
CF_IMAGES_SIGNING_KEY=
